---
import Layout from '../layouts/Layout.astro';
import ProjectGrid from './ProjectGrid.astro';
import ContactLinks from './ContactLinks.astro';
import Icon from './Icon.astro';
import { copy, type Language } from '../lib/i18n';
interface Props { lang: Language; }
const { lang } = Astro.props;
const t = copy[lang];
---
<Layout lang={lang} alternates={{ es: '/es/', en: '/en/' }}>
  <div class="wrapper">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="tiny-line" aria-hidden="true"></span>{t.eyebrow}</p>
        <h1 id="intro-title">{t.greeting}<br /><span>Fernando<span class="text-sand">.</span></span></h1>
        <p class="hero-value">{t.hero}</p>
        <p class="hero-intro">{t.intro}</p>
        <div class="hero-actions flex flex-wrap items-center gap-5">
          <a class="button" href="#projects">{t.explore}<Icon name="arrow" /></a>
          <a class="text-link" href="#about">{t.approach}<span aria-hidden="true">↘</span></a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
        <div class="art-tile tile-one"><Icon name="workflow" /></div>
        <div class="art-tile tile-two"><Icon name="window" /></div>
        <div class="art-tile tile-three"><Icon name="database" /></div>
        <span class="art-dot dot-one"></span><span class="art-dot dot-two"></span><span class="art-plus">+</span>
        <span class="art-caption">{lang === 'es' ? 'IDEAS → SISTEMAS' : 'IDEAS → SYSTEMS'}</span>
      </div>
    </section>
    <aside class="preview-note"><span class="status-dot" aria-hidden="true"></span><strong>{t.preview}</strong><span>{t.previewNote}</span></aside>
    <section id="about" class="about-section section-grid" aria-labelledby="about-title">
      <div class="section-label"><span class="section-number">01 /</span><h2 id="about-title">{t.about}</h2></div>
      <div><h3 class="section-heading">{t.aboutTitle}</h3><p class="reading-copy">{t.aboutText}</p><span class="draft-label">{t.provisional}</span></div>
    </section>
    <section id="projects" class="projects-section" aria-labelledby="projects-title">
      <div class="section-top flex flex-wrap items-start justify-between gap-4">
        <div class="section-label"><span class="section-number">02 /</span><h2 id="projects-title">{t.projects}</h2></div>
        <span class="sample-badge"><span aria-hidden="true">◇</span>{t.sample}</span>
      </div>
      <h3 class="section-heading mt-7">{t.projectsIntro}</h3>
      <p class="text-muted mt-2">{t.projectsHelp}</p>
      <ProjectGrid lang={lang} />
      <p class="sample-footnote">{t.sampleNote}</p>
    </section>
    <section id="journey" class="journey-section section-grid" aria-labelledby="journey-title">
      <div class="section-label"><span class="section-number">03 /</span><h2 id="journey-title">{t.journey}</h2></div>
      <div><h3 class="section-heading">{t.journeyTitle}</h3><p class="reading-copy">{t.journeyText}</p><p class="pending-line"><span aria-hidden="true">○</span>{t.journeyPending}</p></div>
    </section>
    <section id="contact" class="contact-section" aria-labelledby="contact-title">
      <div class="section-label"><span class="section-number">04 /</span><h2 id="contact-title">{t.contact}</h2></div>
      <h3>{t.contactTitle}</h3><p class="text-muted">{t.contactText}</p>
      <ContactLinks lang={lang} />
      <p class="contact-note">{t.contactPending}</p>
    </section>
  </div>
</Layout>
