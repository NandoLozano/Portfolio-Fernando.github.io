---
import Layout from '../layouts/Layout.astro';
import { copy, homePath, type Language } from '../lib/i18n';
interface Props { lang: Language; bilingual?: boolean; }
const { lang, bilingual = false } = Astro.props;
const t = copy[lang];
---
<Layout lang={lang} title={t.errorTitle} alternates={{ es: '/es/404/', en: '/en/404/' }}>
  <div class="wrapper not-found"><p class="eyebrow">404 / Fernando</p><h1>{t.notFound}</h1><p>{t.notFoundText}</p><a class="button" href={homePath(lang)}>{t.goHome}</a>
    {bilingual && <div class="error-english" lang="en"><h2>{copy.en.notFound}</h2><p>{copy.en.notFoundText}</p><a class="text-link" href="/en/">{copy.en.goHome}<span aria-hidden="true">→</span></a></div>}
  </div>
</Layout>
