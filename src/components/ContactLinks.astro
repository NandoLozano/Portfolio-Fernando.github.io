---
import Icon from './Icon.astro';
import { contacts, safeContactUrl, type ContactKind } from '../lib/links';
import { copy, type Language } from '../lib/i18n';
interface Props { lang: Language; compact?: boolean; }
const { lang, compact = false } = Astro.props;
const t = copy[lang];
const items: { kind: ContactKind; label: string }[] = [
  { kind: 'linkedin', label: 'LinkedIn' }, { kind: 'github', label: 'GitHub' }, { kind: 'email', label: t.email },
];
---
<ul class:list={['contact-links', { compact }]} aria-label={t.contact}>
  {items.map(({ kind, label }) => {
    const href = safeContactUrl(kind, contacts[kind]);
    return <li>{href
      ? <a href={href} rel={kind !== 'email' ? 'noopener noreferrer' : undefined}><Icon name={kind} /><span>{label}</span><Icon name="diagonal" class="external-arrow" /></a>
      : compact ? null : <div class="contact-pending"><Icon name={kind} /><div><span>{label}</span><small>{t.pending}</small></div></div>
    }</li>;
  })}
</ul>
