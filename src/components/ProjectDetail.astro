---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import { projects, type Project } from '../data/projects';
import { copy, homePath, projectPath, type Language } from '../lib/i18n';
import { safeProjectUrl, safeScreenshotSrc } from '../lib/links';
interface Props { lang: Language; project: Project; }
const { lang, project } = Astro.props;
const t = copy[lang];
const content = project.content[lang];
const isSample = project.status === 'sample';
const index = projects.findIndex(item => item.id === project.id);
const next = index >= 0 && projects.length > 1 ? projects[(index + 1) % projects.length] : undefined;
const alternates = { es: projectPath('es', project.content.es.slug), en: projectPath('en', project.content.en.slug) };
const stack = project.stack?.filter(text => text.trim()) ?? [];
const flow = content.flow?.filter(text => text.trim()) ?? [];
const decisions = content.decisions?.filter(item => item.title.trim() && item.text.trim()) ?? [];
const validation = content.validation?.filter(text => text.trim()) ?? [];
const results = content.results?.filter(item => item.text.trim() && (item.kind === 'qualitative' || (item.confirmed === true && item.value.trim() && item.basis.trim()))) ?? [];
const repository = safeProjectUrl(project.repository);
const demo = safeProjectUrl(project.demo);
const screenshots = content.screenshots?.flatMap(item => {
  const src = safeScreenshotSrc(item.src);
  return src && item.alt.trim() && Number.isInteger(item.width) && item.width > 0 && Number.isInteger(item.height) && item.height > 0 ? [{ ...item, src }] : [];
}) ?? [];
---
<Layout lang={lang} title={`${content.title}${isSample ? ` · ${t.concept}` : ''} · Fernando`} description={`${content.summary}${isSample ? ` ${t.concept}.` : ''}`} alternates={alternates}>
  <div class="wrapper detail-wrapper">
    <a class="back-link" href={`${homePath(lang)}#projects`}><Icon name="back" />{t.back}</a>
    <article class="case-window">
      <div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{t.caseLabel}{content.category?.trim() && ` / ${content.category}`}</span>{index >= 0 && <span class="window-counter" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}</div>
      <div class="case-content">
        <header class="case-header"><span class={`app-icon ${project.tone}`}><Icon name={project.icon} /></span><div>{isSample && <span class="sample-badge">{t.concept}</span>}<h1>{content.title}</h1><p class="case-summary">{content.summary}</p></div></header>
        {isSample && <aside class="case-notice">{t.conceptNotice}</aside>}
        <dl class="case-meta">
          {content.role?.trim() && <div><dt>{isSample ? t.role : t.realRole}</dt><dd>{content.role}</dd></div>}
          {stack.length > 0 && <div><dt>{isSample ? t.stack : t.realStack}</dt><dd class="flex flex-wrap gap-2">{stack.map(tech => <span class="tech-tag">{tech}</span>)}</dd></div>}
          <div><dt>{t.status}</dt><dd>{isSample ? t.concept : t.real}</dd></div>
        </dl>
        {(content.problem?.trim() || content.solution?.trim()) && <div class="case-columns grid gap-9 md:grid-cols-2">
          {content.problem?.trim() && <section><h2>{t.problem}</h2><p>{content.problem}</p></section>}
          {content.solution?.trim() && <section><h2>{t.solution}</h2><p>{content.solution}</p></section>}
        </div>}
        {flow.length > 0 && <section class="architecture-section"><h2>{t.architecture}</h2>
          <figure><ol class={`flow-diagram ${project.tone}`}>{flow.map((step, index) => <li><span class="flow-number">{String(index + 1).padStart(2, '0')}</span><span>{step}</span>{index < flow.length - 1 && <Icon name="arrow" />}</li>)}</ol>{isSample && <figcaption>{t.architectureNote}</figcaption>}</figure>
        </section>}
        {decisions.length > 0 && <section class="decisions-section"><h2>{t.decisions}</h2><div class="grid gap-6 md:grid-cols-2">{decisions.map(decision => <div class="decision"><h3>{decision.title}</h3><p>{decision.text}</p></div>)}</div></section>}
        {validation.length > 0 && <section class="validation-section results-section"><h2>{t.results}</h2><ul>{validation.map(text => <li><Icon name="check" /><span>{text}</span></li>)}</ul></section>}
        {results.length > 0 && <section class="actual-results results-section"><h2>{t.actualResults}</h2><ul>{results.map(result => <li><Icon name="check" /><div>{result.kind === 'metric' && <strong class="result-value">{result.value}</strong>}<span>{result.text}</span>{result.kind === 'metric' && <p>{result.basis}</p>}</div></li>)}</ul></section>}
        {(repository || demo || screenshots.length > 0) && <section class="evidence-section"><h2>{t.evidence}</h2>
          {(repository || demo) && <div class="evidence-links flex flex-wrap gap-5">
            {repository && <a class="text-link" href={repository} target="_blank" rel="noopener noreferrer">{t.repository}<Icon name="diagonal" /></a>}
            {demo && <a class="text-link" href={demo} target="_blank" rel="noopener noreferrer">{t.demo}<Icon name="diagonal" /></a>}
          </div>}
          {screenshots.map(screenshot => <figure class="project-screenshot"><img src={screenshot.src} alt={screenshot.alt} width={screenshot.width} height={screenshot.height} loading="lazy" decoding="async" />{screenshot.caption?.trim() && <figcaption>{screenshot.caption}</figcaption>}</figure>)}
        </section>}
      </div>
    </article>
    <nav class="case-navigation" aria-label={t.projects}><a class="text-link" href={`${homePath(lang)}#projects`}><Icon name="back" />{t.allProjects}</a>{next && <a class="next-case" href={projectPath(lang, next.content[lang].slug)}><span><small>{t.next}</small>{next.content[lang].title}</span><Icon name="arrow" /></a>}</nav>
  </div>
</Layout>
