---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import { projects, type Project } from '../data/projects';
import { copy, homePath, projectPath, type Language } from '../lib/i18n';
interface Props { lang: Language; project: Project; }
const { lang, project } = Astro.props;
const t = copy[lang];
const content = project.content[lang];
const next = projects[(projects.findIndex(item => item.id === project.id) + 1) % projects.length]!;
const alternates = { es: projectPath('es', project.content.es.slug), en: projectPath('en', project.content.en.slug) };
---
<Layout lang={lang} title={`${content.title} · ${t.concept} · Fernando`} description={`${content.summary} ${t.concept}.`} alternates={alternates}>
  <div class="wrapper detail-wrapper">
    <a class="back-link" href={`${homePath(lang)}#projects`}><Icon name="back" />{t.back}</a>
    <article class="case-window">
      <div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{t.caseLabel} / {content.category}</span><span class="window-counter" aria-hidden="true">0{projects.indexOf(project) + 1}</span></div>
      <div class="case-content">
        <header class="case-header"><span class={`app-icon ${project.tone}`}><Icon name={project.icon} /></span><div><span class="sample-badge">{t.concept}</span><h1>{content.title}</h1><p class="case-summary">{content.summary}</p></div></header>
        <aside class="case-notice">{t.conceptNotice}</aside>
        <dl class="case-meta"><div><dt>{t.role}</dt><dd>{content.role}</dd></div><div><dt>{t.stack}</dt><dd class="flex flex-wrap gap-2">{project.stack.map(tech => <span class="tech-tag">{tech}</span>)}</dd></div><div><dt>{t.status}</dt><dd>{t.concept}</dd></div></dl>
        <div class="case-columns grid gap-9 md:grid-cols-2">
          <section><p class="section-number">01 /</p><h2>{t.problem}</h2><p>{content.problem}</p></section>
          <section><p class="section-number">02 /</p><h2>{t.solution}</h2><p>{content.solution}</p></section>
        </div>
        <section class="architecture-section"><p class="section-number">03 /</p><h2>{t.architecture}</h2>
          <figure><ol class={`flow-diagram ${project.tone}`}>{content.flow.map((step, index) => <li><span class="flow-number">0{index + 1}</span><span>{step}</span>{index < 2 && <Icon name="arrow" />}</li>)}</ol><figcaption>{t.architectureNote}</figcaption></figure>
        </section>
        <section class="decisions-section"><h2>{t.decisions}</h2><div class="grid gap-6 md:grid-cols-2">{content.decisions.map(decision => <div class="decision"><h3>{decision.title}</h3><p>{decision.text}</p></div>)}</div></section>
        <section class="results-section"><p class="section-number">04 /</p><h2>{t.results}</h2><ul>{content.validation.map(text => <li><Icon name="check" /><span>{text}</span></li>)}</ul></section>
        <section class="evidence-section"><h2>{t.evidence}</h2><p>{t.evidenceText}</p></section>
      </div>
    </article>
    <nav class="case-navigation" aria-label={t.projects}><a class="text-link" href={`${homePath(lang)}#projects`}><Icon name="back" />{t.allProjects}</a><a class="next-case" href={projectPath(lang, next.content[lang].slug)}><span><small>{t.next}</small>{next.content[lang].title}</span><Icon name="arrow" /></a></nav>
  </div>
</Layout>
