---
interface Props { name: string; class?: string; }
const { name, class: className } = Astro.props;
---
<svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow' && <><path d="M4 12h16M14 6l6 6-6 6" /></>}
  {name === 'diagonal' && <><path d="M6 18 18 6M6 6h12v12" /></>}
  {name === 'back' && <><path d="M20 12H4m6-6-6 6 6 6" /></>}
  {name === 'up' && <><path d="M12 20V4m-6 6 6-6 6 6" /></>}
  {name === 'workflow' && <><rect x="3" y="3" width="6" height="6" rx="1.5" /><rect x="15" y="15" width="6" height="6" rx="1.5" /><path d="M6 9v6a3 3 0 0 0 3 3h6m-4-9h4a3 3 0 0 1 3 3v1" /><path d="m12 7-2 2 2 2" /></>}
  {name === 'window' && <><rect x="3" y="4" width="18" height="16" rx="2.5" /><path d="M3 9h18M9 9v11M6 6.5h.01m3 0h.01" /></>}
  {name === 'database' && <><ellipse cx="12" cy="5.5" rx="8" ry="3" /><path d="M4 5.5v13c0 1.7 3.6 3 8 3s8-1.3 8-3v-13M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" /></>}
  {name === 'github' && <><path d="M9 19c-4 1-4-2-6-2m12 5v-4a3.5 3.5 0 0 0-1-2.7c3.3-.4 6.8-1.6 6.8-7a5.5 5.5 0 0 0-1.5-3.8 5 5 0 0 0-.1-3.7S18 1.4 15 3a13 13 0 0 0-6 0C6 1.4 4.8 1.8 4.8 1.8a5 5 0 0 0-.1 3.7 5.5 5.5 0 0 0-1.5 3.8c0 5.4 3.5 6.6 6.8 7A3.5 3.5 0 0 0 9 19v3" /></>}
  {name === 'linkedin' && <><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M7 10v7m0-10h.01M11 17v-7m0 3a3 3 0 0 1 6 0v4" /></>}
  {name === 'email' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></>}
  {name === 'check' && <path d="m5 12 4 4L19 6" />}
</svg>
